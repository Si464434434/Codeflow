# ── Server ────────────────────────────────────────────────
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────
# Get this from: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/codeflow?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/codeflow?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────
# Generate a strong random string (min 32 chars)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ── Frontend URL (for CORS) ───────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Email (Nodemailer via Gmail) ──────────────────────────
# For Gmail: enable 2FA → generate App Password
# https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=CodeFlow Community <your_gmail@gmail.com>

# ── Admin seed (optional) ────────────────────────────────
ADMIN_SEED_EMAIL=admin@codeflow.dev
ADMIN_SEED_PASSWORD=Admin@123456
